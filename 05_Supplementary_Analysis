EPS <- 1e-8
to_lp <- function(pr) { pr <- pmin(pmax(pr, EPS), 1 - EPS); log(pr / (1 - pr)) }

cal_metrics <- function(pr, y) {
  lp <- to_lp(pr)
  slope <- tryCatch(as.numeric(coef(glm(y ~ lp, family = binomial))[2]),
                    error = function(e) NA_real_, warning = function(w) {
                      suppressWarnings(as.numeric(coef(glm(y ~ lp, family = binomial))[2])) })
  inter <- tryCatch(as.numeric(coef(glm(y ~ offset(lp), family = binomial))[1]),
                    error = function(e) NA_real_, warning = function(w) {
                      suppressWarnings(as.numeric(coef(glm(y ~ offset(lp), family = binomial))[1])) })
  c(slope = slope, intercept = inter, brier = mean((pr - y)^2))
}

fit_lasso_inner <- function(Xtr, ytr) {
  cvf <- cv.glmnet(Xtr, ytr, family = "binomial", alpha = 1,
                   type.measure = "deviance", nfolds = min(10, length(ytr)))
  lam <- cvf$lambda.min
  fit <- glmnet(Xtr, ytr, family = "binomial", alpha = 1, lambda = lam)
  list(predict_fun = function(Xnew)
    as.numeric(predict(fit, newx = Xnew, type = "response", s = lam)),
    selected = setdiff(rownames(coef(fit))[which(as.numeric(coef(fit)) != 0)],
                       "(Intercept)"))
}

