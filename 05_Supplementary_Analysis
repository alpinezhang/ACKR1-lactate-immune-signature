score_set <- function(obj, genes, name) {
  if (length(genes) < 3) {
    message("   ! ", name, " has fewer than three available genes; skipped.")
    return(NULL)
  }
  obj <- AddModuleScore(obj, features = list(genes), name = name,
                        ctrl = min(100, length(obj_genes) %/% 24))
  obj[[paste0(name, "1")]][, 1]
}

