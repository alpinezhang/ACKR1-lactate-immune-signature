stat_one <- function(v, g, nm) {
  a <- v[g == "non-IPH"]; b <- v[g == "IPH"]
  w <- wilcox.test(b, a)
  
  d <- mean(sign(outer(b, a, "-")))
  data.frame(Variable = nm,
             median_nonIPH = round(median(a), 3), median_IPH = round(median(b), 3),
             mean_nonIPH = round(mean(a), 3),   mean_IPH = round(mean(b), 3),
             Wilcoxon_P = signif(w$p.value, 3),
             Cliffs_delta = round(d, 3))
}

