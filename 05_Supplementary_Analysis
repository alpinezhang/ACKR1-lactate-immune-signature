safe_z <- function(g) {
  if (g %in% rownames(mat_z)) {
    v <- mat_z[g, ]; v[is.nan(v) | is.na(v)] <- 0; v
  } else {
    warning(sprintf("Gene %s was not detected; using zero.", g)); rep(0, ncol(mat_z))
  }
}

dat <- data.frame(
