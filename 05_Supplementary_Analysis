              s_cl$conf.int[1, "lower .95"],
              s_cl$conf.int[1, "upper .95"])
p_strat  <- s_cl$coefficients[1, "Pr(>|z|)"]

fit_glm <- glm(Status ~ Logit_P_sd, data = dat, family = binomial())
or_unstrat <- exp(c(coef(fit_glm)[2], confint.default(fit_glm)[2, ]))

message(sprintf("Stratified OR=%.3f (%.3f-%.3f), P=%.4g",
                or_strat[1], or_strat[2], or_strat[3], p_strat))
message(sprintf("Unstratified OR=%.3f (%.3f-%.3f)",
                or_unstrat[1], or_unstrat[2], or_unstrat[3]))
message(sprintf("Stratified/unstratified effect ratio = %.2f",
                or_strat[1] / or_unstrat[1]))

message(">>> [Step 6] Per-feature paired analysis ...")

feat_res <- lapply(FEATS, function(f) {
  a <- wide[[paste0(f, "__", PLQ)]]; b <- wide[[paste0(f, "__", NRM)]]
  d <- a - b
  w  <- wilcox.test(a, b, paired = TRUE, exact = FALSE)
  cl <- clogit(as.formula(paste0("Status ~ ", f, " + strata(Patient)")), data = dat)
  scl <- summary(cl)
  data.frame(
    Feature      = f,
    Locked_coef  = as.numeric(COEF[f]),
    Mean_diff    = mean(d, na.rm = TRUE),
    N_concordant = sum(d > 0, na.rm = TRUE),
    N_pairs      = n_pair,
    Concordance  = sprintf("%d/%d", sum(d > 0, na.rm = TRUE), n_pair),
    Paired_Wilcox_P = w$p.value,
    OR_clogit    = scl$conf.int[1, "exp(coef)"],
    OR_low       = scl$conf.int[1, "lower .95"],
    OR_high      = scl$conf.int[1, "upper .95"],
    clogit_P     = scl$coefficients[1, "Pr(>|z|)"],
    stringsAsFactors = FALSE
  )
}) %>% dplyr::bind_rows()
feat_res$Wilcox_FDR <- p.adjust(feat_res$Paired_Wilcox_P, method = "BH")
