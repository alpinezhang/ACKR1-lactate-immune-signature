run_kegg_updown <- function(dd, pcol, fcol) {
  sig <- dd %>% filter(.data[[pcol]] < 0.05, !is.na(ENTREZID))
  up  <- sig %>% filter(.data[[fcol]] > 0) %>% pull(ENTREZID)
  dn  <- sig %>% filter(.data[[fcol]] < 0) %>% pull(ENTREZID)
  f <- function(g) {
    if (length(g) < 10) return(data.frame())
    k <- tryCatch(enrichKEGG(gene = g, organism = "hsa", pvalueCutoff = 0.05),
                  error = function(e) NULL)
    if (is.null(k) || nrow(as.data.frame(k)) == 0) return(data.frame())
    as.data.frame(setReadable(k, OrgDb = org.Hs.eg.db, keyType = "ENTREZID"))
  }
  list(up = f(up), down = f(dn), n_up = length(up), n_dn = length(dn))
}
