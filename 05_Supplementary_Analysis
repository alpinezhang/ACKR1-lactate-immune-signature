get_patient <- function(ph) {
  cand <- grep("^patient", tolower(colnames(ph)), value = TRUE)
  if (length(cand) > 0) {
    v <- as.character(ph[[cand[1]]])
    if (all(!is.na(v)) && length(unique(v)) > 1) {
      return(sprintf("P%02d", as.integer(gsub("\\D", "", v))))
    }
  }
  v <- sub("^\\s*Patient\\s*([0-9]+).*$", "\\1", as.character(ph$title), ignore.case = TRUE)
  sprintf("P%02d", as.integer(v))
}
