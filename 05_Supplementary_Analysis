COEF <- c(intercept = 0.4625, SLC16A4_Z = -2.6931, SLC16A3_Z = 0.6481,
          ACKR1_Z = 0.2556, CD8_Tox_Z = 0.7414)
dat$Logit_P <- COEF["intercept"] +
  COEF["SLC16A4_Z"] * dat$SLC16A4_Z + COEF["SLC16A3_Z"] * dat$SLC16A3_Z +
  COEF["ACKR1_Z"]   * dat$ACKR1_Z   + COEF["CD8_Tox_Z"] * dat$CD8_Tox_Z
dat$Prob <- 1 / (1 + exp(-dat$Logit_P))

dat <- dat %>% dplyr::filter(Patient %in% complete_pairs)
n_pair <- length(unique(dat$Patient))

sd_lp <- sd(dat$Logit_P, na.rm = TRUE)
dat$Logit_P_sd <- dat$Logit_P / sd_lp

FEATS <- c("SLC16A4_Z", "SLC16A3_Z", "ACKR1_Z", "CD8_Tox_Z")
PLQ <- "Stage IV-V (Advanced)"; NRM <- "Stage I-II (Early)"

message(">>> [Step 3] Unstratified AUC and cluster bootstrap CI ...")

roc_all   <- roc(dat$Status, dat$Prob, levels = c(0, 1), direction = "<", quiet = TRUE)
auc_naive <- as.numeric(roc_all$auc)
ci_naive  <- as.numeric(ci.auc(roc_all))

pts <- unique(dat$Patient)
boot_auc <- replicate(B_BOOT, {
  s   <- sample(pts, length(pts), replace = TRUE)
  idx <- unlist(lapply(s, function(p) which(dat$Patient == p)))
  d   <- dat[idx, ]
  if (length(unique(d$Status)) < 2) return(NA_real_)
  as.numeric(roc(d$Status, d$Prob, levels = c(0, 1),
                 direction = "<", quiet = TRUE)$auc)
})
ci_boot <- quantile(boot_auc, c(.025, .975), na.rm = TRUE)

message(sprintf("AUC = %.3f | Naive CI %.3f-%.3f | Cluster bootstrap CI %.3f-%.3f",
                auc_naive, ci_naive[1], ci_naive[3], ci_boot[1], ci_boot[2]))

message(">>> [Step 4] Within-patient paired analysis ...")

wide <- dat %>%
  dplyr::select(Patient, Tissue, Logit_P, Prob, dplyr::all_of(FEATS)) %>%
  tidyr::pivot_wider(names_from = Tissue,
                     values_from = c(Logit_P, Prob, dplyr::all_of(FEATS)),
                     names_sep = "__")
wide$diff_logit <- wide[[paste0("Logit_P__", PLQ)]] - wide[[paste0("Logit_P__", NRM)]]

n_conc <- sum(wide$diff_logit > 0, na.rm = TRUE)
n_tie  <- sum(wide$diff_logit == 0, na.rm = TRUE)
conc_rate <- (n_conc + 0.5 * n_tie) / n_pair
bt <- binom.test(n_conc, n_pair, p = 0.5)

boot_conc <- replicate(B_BOOT, {
  s <- sample(pts, length(pts), replace = TRUE)
  d <- wide$diff_logit[match(s, wide$Patient)]
  mean(d > 0, na.rm = TRUE)
})
ci_conc <- quantile(boot_conc, c(.025, .975), na.rm = TRUE)

wil <- wilcox.test(wide[[paste0("Logit_P__", PLQ)]],
                   wide[[paste0("Logit_P__", NRM)]], paired = TRUE, exact = FALSE)
tt  <- t.test(wide[[paste0("Logit_P__", PLQ)]],
              wide[[paste0("Logit_P__", NRM)]], paired = TRUE)

message(sprintf("Concordance %d/%d (%.1f%%) | Binomial P=%.4g | Bootstrap CI %.3f-%.3f",
                n_conc, n_pair, 100 * conc_rate, bt$p.value, ci_conc[1], ci_conc[2]))
message(sprintf("Paired Wilcoxon P=%.4g | Paired t-test mean difference=%.3f (%.3f, %.3f) P=%.4g",
                wil$p.value, tt$estimate, tt$conf.int[1], tt$conf.int[2], tt$p.value))

message(">>> [Step 5] Stratified and unstratified effects ...")

