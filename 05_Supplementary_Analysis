EPS <- 1e-8
to_lp <- function(pr) { pr <- pmin(pmax(pr, EPS), 1 - EPS); log(pr / (1 - pr)) }

cal_robust <- function(pr, y) {
  lp <- to_lp(pr)
  sd_lp <- sd(lp)
  if (!is.finite(sd_lp) || sd_lp < 1e-6 || length(unique(y)) < 2)
    return(c(slope = NA, slope_firth = NA, intercept = NA, brier = NA, degenerate = 1))
  
  s_mle <- suppressWarnings(tryCatch(
    as.numeric(coef(glm(y ~ lp, family = binomial))[2]), error = function(e) NA))
  degen <- as.integer(!is.finite(s_mle) || abs(s_mle) > 25)
  
  s_fir <- suppressWarnings(tryCatch(
    as.numeric(coef(logistf(y ~ lp, data = data.frame(y = y, lp = lp)))[2]),
    error = function(e) NA))
  inter <- suppressWarnings(tryCatch(
    as.numeric(coef(glm(y ~ offset(lp), family = binomial))[1]), error = function(e) NA))
  c(slope = s_mle, slope_firth = s_fir, intercept = inter,
    brier = mean((pr - y)^2), degenerate = degen)
}

