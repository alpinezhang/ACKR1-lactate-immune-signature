  if (sum(ok) >= 4 && sd(x[ok])>0 && sd(y[ok])>0) {
    ct <- cor.test(x[ok], y[ok], method = "spearman")
    cor_within_ec <- rbind(cor_within_ec,
                           data.frame(Gene=g, R=unname(ct$estimate), P=ct$p.value, n=sum(ok)))
  }
}
