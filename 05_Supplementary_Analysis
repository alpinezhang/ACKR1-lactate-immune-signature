fit_lasso_inner <- function(Xtr, ytr) {
  cvf <- cv.glmnet(Xtr, ytr, family = "binomial", alpha = 1,
                   type.measure = "deviance", nfolds = min(10, length(ytr)))
  lam <- cvf$lambda.min
  fit <- glmnet(Xtr, ytr, family = "binomial", alpha = 1, lambda = lam)
  list(predict_fun = function(Xn)
    as.numeric(predict(fit, newx = Xn, type = "response", s = lam)))
}

